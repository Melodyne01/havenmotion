{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=studiovnl;Username=studiovnl;Password=studiovnl"
  },
  "Jwt": {
    "Issuer": "StudioVnl",
    "Audience": "StudioVnl",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "MediaStorage": {
    "Provider": "LocalDisk",
    "LocalDisk": {
      "RootPath": "media-store",
      "PublicBaseUrl": "/media"
    },
    "S3": {
      "ServiceUrl": "http://localhost:9000",
      "Bucket": "vnl-media",
      "AccessKey": "",
      "SecretKey": "",
      "CdnBaseUrl": null,
      "SignedUrlMinutes": 60
    }
  },
  "Ffmpeg": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "MaxHeight": 1080,
    "VideoBitrateKbps": 5500
  },
  "Email": {
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "FromAddress": "no-reply@studiovnl.fr",
    "FromName": "Studio VNL"
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "Seed": {
    "AdminEmail": "admin@studiovnl.fr",
    "AdminPassword": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
